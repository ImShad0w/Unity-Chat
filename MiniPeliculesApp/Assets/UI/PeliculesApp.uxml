<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PeliculesApp.uss?fileID=7433441132597879392&amp;guid=489c147ab7de910f2beff8ca72b73a5d&amp;type=3#PeliculesApp"/>
    <ui:Label text="App Jokes" name="header" style="background-color: rgb(244, 164, 96); font-size: 20px; -unity-text-align: upper-center; -unity-font-style: bold;"/>
    <ui:VisualElement name="mainContainer" style="flex-grow: 1; flex-direction: row; background-color: rgb(160, 82, 45); width: 100%; height: 100%;">
        <ui:VisualElement name="leftPanel" style="flex-grow: 1; width: auto; max-width: 50%; min-width: 30%;">
            <ui:VisualElement name="formContainer" style="flex-grow: 1;">
                <ui:TextField label="Setup line" placeholder-text="What do you call fake spaghetti?" name="setupField" style="flex-direction: column;"/>
                <ui:TextField label="Punchline" placeholder-text="An impasta." name="punchField" style="flex-direction: column;"/>
                <ui:Button text="Afegir broma" name="addJoke"/>
            </ui:VisualElement>
            <ui:ListView name="jokesContainer" style="max-height: 40%; min-height: 40%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="rightPanel" style="flex-grow: 1;">
            <ui:Label text="Select a Joke" name="descSetupLabel"/>
            <ui:Label text="Select a Joke" name="descPunchLabel"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
