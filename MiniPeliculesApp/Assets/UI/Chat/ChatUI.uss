/* ==========================================================================
   Chat messages — Telegram-style bubbles
   Structure to build per message:
     .message-item          row wrapper
       .message-nickname    sender name, sits above the bubble
       .message-bubble      purple bubble
         .message-text      message, inside the bubble
   ========================================================================== */

.message-item {
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 4px 12px 10px 12px;
}

.message-nickname {
    margin: 0 0 3px 12px;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: #8776ea;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.message-bubble {
    align-self: flex-start;
    max-width: 70%;
    padding: 8px 12px;
    background-color: #8776ea;
    /* Sharp top-left corner "attaches" the bubble to the nickname */
    border-top-left-radius: 4px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
}

.message-text {
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: #ffffff;
    white-space: normal;
    -unity-text-align: upper-left;
}
